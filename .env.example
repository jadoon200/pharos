# Copy to .env and fill in. Everything works with defaults + no keys (NOAA bulk + demo seed).
# Host port 5434 so PHAROS's Postgres coexists with SENTINEL (5432) and ARGUS (5433).
PHAROS_DATABASE_URL=postgresql+psycopg://pharos:pharos@localhost:5434/pharos

# --- Live AIS lane (optional) ----------------------------------------------------------
# AISStream.io free WebSocket key. Only used by `make live` (the `live` extra). Leave empty
# to run entirely on the free NOAA Marine Cadastre bulk data — no key, fully reproducible.
PHAROS_AISSTREAM_KEY=

# --- Global Fishing Watch label cross-check (optional) ---------------------------------
# Free API token (registration). Used only by the eval's GFW cross-check; empty disables it.
PHAROS_GFW_TOKEN=
