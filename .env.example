# Copy to .env and fill in. Everything works with defaults + no keys (NOAA bulk + demo seed).
# Host port 5434 so PHAROS's Postgres coexists with SENTINEL (5432) and ARGUS (5433).
PHAROS_DATABASE_URL=postgresql+psycopg://pharos:pharos@localhost:5434/pharos

# --- Live AIS lane (optional) ----------------------------------------------------------
# AISStream.io free WebSocket key. Only used by `make live` (the `live` extra). Leave empty
# to run entirely on the free NOAA Marine Cadastre bulk data — no key, fully reproducible.
PHAROS_AISSTREAM_KEY=

# Continuous collector: use a local WAL database and bounded M3 Pro resource defaults.
# PHAROS_DATABASE_URL=sqlite:///data/sg-live.db
# PHAROS_COLLECTOR_BATCH_SECONDS=45
# PHAROS_COLLECTOR_DOWNSAMPLE_SECONDS=45
# PHAROS_COLLECTOR_HEALTH_TIMEOUT_SECONDS=90
# PHAROS_PROCESS_INTERVAL_MINUTES=2
# PHAROS_RETENTION_POSITIONS_DAYS=21
# PHAROS_STORAGE_WARN_GB=2
# PHAROS_STORAGE_HARD_GB=5
# Official evaluation boundary; omit outside a frozen pilot.
# PHAROS_PILOT_START_AT=2026-07-16T02:47:51Z
# Pin this to the frozen model's SHA during a frozen pilot.
# PHAROS_ANOMALY_MODEL_SHA256=
# PHAROS_LABELS_DIR=data/labels
# PHAROS_LABEL_MATCH_MAX_HOURS=24
# PHAROS_LABEL_MATCH_MAX_KM=25
# PHAROS_REVIEW_QUEUE_MIN=220
# PHAROS_REVIEW_REREVIEW_FRACTION=0.15
# PHAROS_SNAPSHOTS_DIR=data/snapshots
# PHAROS_SNAPSHOT_DELAY_MINUTES=15

# --- Global Fishing Watch label cross-check (optional) ---------------------------------
# Free API token (registration). Used only by the eval's GFW cross-check; empty disables it.
PHAROS_GFW_TOKEN=
